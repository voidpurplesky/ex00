<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zerock.board.mapper.BoardMapper">
  <select id="list" resultType="org.zerock.board.vo.BoardVO">
  select no, title, writer, writedate, hit
  
  from  
  (
  	select rownum rnum, no, title, writer, writedate, hit 
  	from 
  	(
  		select no, title, writer, writedate, hit 
  		from board
  		<include refid="search"></include>
  		order by no desc
  	)
  )
  where rnum between #{startRow} and #{endRow}
  </select>
  
<!--   <insert id="write" parameterType="org.zerock.board.vo.BoardVO">
  insert into board(no, title, content, writer, pw)
  values (board_seq.nextval, #{title}, #{content}, #{writer}, #{pw})
  </insert> -->
  
    <select id="view" parameterType="Long" resultType="org.zerock.board.vo.BoardVO">
  select no, title, content, writer, writedate, hit 
  from board
  where no = #{no}
  </select>
  
  <update id="increase" parameterType="Long">
  update board set hit = hit+1 where no = #{no}
  </update>
  
  <select id="getTotalRow" resultType="Long">
  select count(no) from board
  </select>
  
  <insert id="write">
  	<selectKey keyProperty="no" resultType="Long" order="BEFORE">
  		select board_seq.nextval from dual
  	</selectKey>
  	  insert into board(no, title, content, writer, pw)
  	values (#{no}, #{title}, #{content}, #{writer}, #{pw})
  </insert>
  
    <insert id="writeTx">
  	  insert into board(no, title, content, writer, pw)
  	values (#{no}, #{title}, #{content}, #{writer}, #{pw})
  </insert>
  
  <update id="update">
  <!-- ![CDATA[]] -->
<![CDATA[
  update board set 
  title = #{title}
  , content = #{content}
  , writer = #{writer}
  where no = #{no} and pw = #{pw}
  ]]>
  </update>
  <delete id="delete" parameterType="Long">
  delete from board
  where no = #{no}
  </delete>
  
	<!-- 일반리스트 검색 -->
	<sql id="search">
	<if test="word != null and word != ''.toString()">
		<trim prefix="where" prefixOverrides="or">
			<if test="key.indexOf('t') >= 0">
				or title like '%' || #{word} || '%'
			</if>
			<if test="key.indexOf('w') >= 0">
				or writer like '%' || #{word} || '%'
			</if>
			<if test="key.indexOf('c') >= 0">
				or content like '%' || #{word} || '%'
			</if>
		</trim>
		</if>
	</sql>
